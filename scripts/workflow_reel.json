{
  "1": {
    "inputs": {
      "ckpt_name": "v1-5-pruned-emaonly.safetensors"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Load Checkpoint"
    }
  },
  "2": {
    "inputs": {
      "model_name": "mm_sd_v15_v2.ckpt"
    },
    "class_type": "AnimateDiffLoader",
    "_meta": {
      "title": "Load AnimateDiff Model"
    }
  },
  "3": {
    "inputs": {
      "control_net_name": "control_v11p_sd15_openpose.pth"
    },
    "class_type": "ControlNetLoader",
    "_meta": {
      "title": "Load ControlNet Model"
    }
  },
  "4": {
    "inputs": {
      "image": "product_image.png",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Load Product Image"
    }
  },
  "5": {
    "inputs": {
      "width": 576,
      "height": 1024,
      "batch_size": 16
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Empty Latent (16 frames, 576x1024)"
    }
  },
  "6": {
    "inputs": {
      "text": "high quality product photography, professional lighting, clean background, commercial photography, 8k, sharp focus, detailed texture",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive Prompt"
    }
  },
  "7": {
    "inputs": {
      "text": "blurry, low quality, distorted, ugly, bad anatomy, watermark, text, signature, logo, watermark, username, blurry, amateur, lowres, pixelated",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative Prompt"
    }
  },
  "8": {
    "inputs": {
      "image": ["4", 0],
      "control_net": ["3", 0],
      "strength": 1.0,
      "start_percent": 0.0,
      "end_percent": 1.0
    },
    "class_type": "ControlNetApplyAdvanced",
    "_meta": {
      "title": "Apply ControlNet (OpenPose)"
    }
  },
  "9": {
    "inputs": {
      "model": ["1", 0],
      "motion_model": ["2", 0],
      "apply_to": "attention",
      "beta_schedule": "sqrt_linear",
      "context_options": {
        "context_length": 16,
        "context_stride": 1,
        "context_overlap": 4,
        "closed_loop": false
      }
    },
    "class_type": "AnimateDiffModelLoader",
    "_meta": {
      "title": "Apply AnimateDiff"
    }
  },
  "10": {
    "inputs": {
      "model": ["9", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "vae": ["1", 2],
      "latent_image": ["5", 0],
      "control_net": ["8", 0],
      "seed": 42,
      "steps": 20,
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler (AnimateDiff + ControlNet)"
    }
  },
  "11": {
    "inputs": {
      "samples": ["10", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "12": {
    "inputs": {
      "filename_prefix": "reel_product",
      "images": ["11", 0]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Frames"
    }
  }
}